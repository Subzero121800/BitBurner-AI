# bridge/.env.example
#
# The bridge uses the LOCAL Claude Code CLI (claude -p) and inherits
# its auth automatically — no API key needs to live in this process.
# Copy to bridge/.env only if you want to override defaults.

# Override which Claude Code binary to use (e.g. nvm/asdf)
# CLAUDE_BIN=/Users/you/.local/bin/claude

# Override which model to ask for (passed via `claude --model`)
# CLAUDE_MODEL=sonnet

# HTTP listen port
# PORT=3000

# Per-request timeout in milliseconds
# CLAUDE_TIMEOUT_MS=90000
